<mujoco model="offline_pair_example">
  <option timestep="0.002" integrator="implicitfast"/>
  <worldbody>
    <geom name="floor" type="plane" size="1 1 .1"/>
    <body name="ball" pos="0 0 .15">
      <freejoint name="root"/>
      <geom name="ball_geom" type="sphere" size=".05" mass=".1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
  <contact><pair geom1="ball_geom" geom2="floor" condim="6" friction=".8 .4 .01 .001 .002" solref=".005 1"/></contact>
  <keyframe><key name="home" qpos="0 0 .15 1 0 0 0"/></keyframe>
</mujoco>
